# Deployment Compose reads API keys, the token pepper, and SMTP credentials
# from ignored files under secrets/. Do not place their values in this file.
# Production: use only the HTTPS browser origin. Local development may use localhost.
ALLOWED_ORIGINS=https://resume.example.com
# Local-only override. Production Docker Compose reads DATABASE_PASSWORD_FILE instead.
# DATABASE_URL=postgresql+psycopg://resumebuddy:password@localhost:5432/resumebuddy
PUBLIC_APP_URL=https://resume.example.com
PUBLIC_APP_HOST=resume.example.com
APP_ENV=production
REQUIRE_HTTPS=true
SESSION_COOKIE_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM=
LOG_LEVEL=INFO
# Abuse-protection ceilings. Keep production values conservative and monitor 429 logs.
API_RATE_LIMIT_MAX_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
READ_RATE_LIMIT_MAX_REQUESTS=60
AUTH_LOGIN_RATE_LIMIT_MAX_REQUESTS=10
AUTH_REGISTER_RATE_LIMIT_MAX_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=300
AI_USER_RATE_LIMIT_MAX_REQUESTS=10
