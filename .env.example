# Deployment Compose reads API keys, the token pepper, and SMTP credentials
# from ignored files under secrets/. Do not place their values in this file.
# Production: use only the HTTPS browser origin. Local development may use localhost.
ALLOWED_ORIGINS=https://resume.example.com
# Local-only override. Put the full URL only in your ignored .env file.
# Production Docker Compose reads DATABASE_PASSWORD_FILE instead.
# DATABASE_URL=<local PostgreSQL connection URL>
PUBLIC_APP_URL=https://resume.example.com
PUBLIC_APP_HOST=resume.example.com
APP_ENV=production
REQUIRE_HTTPS=true
SESSION_COOKIE_SECURE=true
# Local-development only: enable checked-in static profiles. Production defaults to false.
STATIC_PROFILES_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM=
LOG_LEVEL=INFO
# Abuse-protection ceilings. Keep production values conservative and monitor 429 logs.
API_RATE_LIMIT_MAX_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
READ_RATE_LIMIT_MAX_REQUESTS=60
AUTH_LOGIN_RATE_LIMIT_MAX_REQUESTS=10
AUTH_REGISTER_RATE_LIMIT_MAX_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=300
AI_USER_RATE_LIMIT_MAX_REQUESTS=10
# Bound simultaneous Chromium PDF renders; waiting longer than the timeout returns 503.
PDF_MAX_CONCURRENCY=2
PDF_QUEUE_TIMEOUT_SECONDS=30
# Hard limit for one render; a hung Chromium is killed and the request gets 503.
PDF_RENDER_TIMEOUT_SECONDS=45
# Who may create an account: closed (default when unset), allowlist, or open.
# Any other value stops the app at startup. Allowlist mode with an empty list is closed.
# Refused addresses get the same 202 response as accepted ones; nothing is created or sent.
REGISTRATION_MODE=closed
# Allowlist mode only: comma-separated emails, trimmed and lowercased, exact match (no alias handling).
# REGISTRATION_ALLOWLIST=you@example.com,friend@example.com
# Every secret (ANTHROPIC_API_KEY, GROQ_API_KEY, AUTH_TOKEN_PEPPER, SMTP_USERNAME, SMTP_PASSWORD,
# DATABASE_PASSWORD) may be given as NAME (plain env var) or NAME_FILE (mounted file), never both:
# setting both stops the app at startup. DATABASE_URL may use postgres:// or postgresql://; both are
# rewritten to the installed psycopg 3 driver (postgresql+psycopg://).
# The container listens on $PORT (default 8000) and runs a single uvicorn worker.
# PORT=8000
# Proxy addresses whose X-Forwarded-* headers uvicorn trusts (comma-separated IPs, or * for all).
# Defaults to 127.0.0.1. Behind a hosting proxy, per-IP rate limits and logs see the proxy's address
# until this includes it. The value for your host is deliberately not set here; choose it yourself.
# The bundled docker-compose.yml sets it to * for its Caddy container.
# FORWARDED_ALLOW_IPS=127.0.0.1
